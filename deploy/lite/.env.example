NODE_ENV=production

FLUXER_APP_ENDPOINT=https://atomicradius.app
FLUXER_API_PUBLIC_ENDPOINT=https://atomicradius.app/api
FLUXER_API_CLIENT_ENDPOINT=http://api:8080
FLUXER_GATEWAY_ENDPOINT=wss://atomicradius.app/gateway
FLUXER_MEDIA_ENDPOINT=https://atomicradius.app/media
FLUXER_CDN_ENDPOINT=https://atomicradius.app
FLUXER_MARKETING_ENDPOINT=https://atomicradius.app
FLUXER_ADMIN_ENDPOINT=https://atomicradius.app
FLUXER_INVITE_ENDPOINT=https://atomicradius.app
FLUXER_GIFT_ENDPOINT=https://atomicradius.app

FLUXER_API_PORT=8080
FLUXER_GATEWAY_WS_PORT=8080
FLUXER_GATEWAY_RPC_PORT=8081
FLUXER_GATEWAY_RPC_HOST=gateway
FLUXER_GATEWAY_PUSH_ENABLED=false
FLUXER_GATEWAY_PUSH_USER_GUILD_SETTINGS_CACHE_MB=16
FLUXER_GATEWAY_PUSH_SUBSCRIPTIONS_CACHE_MB=16
FLUXER_GATEWAY_PUSH_BLOCKED_IDS_CACHE_MB=16
FLUXER_GATEWAY_IDENTIFY_RATE_LIMIT_ENABLED=false

FLUXER_PATH_GATEWAY=/gateway
FLUXER_PATH_ADMIN=/admin
FLUXER_PATH_MARKETING=/marketing

DATABASE_URL=postgresql://postgres:postgres@postgres:5432/fluxer
REDIS_URL=redis://redis:6379
CASSANDRA_HOSTS=cassandra
CASSANDRA_KEYSPACE=fluxer
CASSANDRA_LOCAL_DC=datacenter1
CASSANDRA_USERNAME=cassandra
CASSANDRA_PASSWORD=cassandra

AWS_S3_ENDPOINT=http://minio-disabled:9000
AWS_ACCESS_KEY_ID=disabled
AWS_SECRET_ACCESS_KEY=disabled
AWS_S3_BUCKET_CDN=fluxer
AWS_S3_BUCKET_UPLOADS=fluxer-uploads
AWS_S3_BUCKET_DOWNLOADS=fluxer-downloads
AWS_S3_BUCKET_REPORTS=fluxer-reports
AWS_S3_BUCKET_HARVESTS=fluxer-harvests
R2_S3_ENDPOINT=http://minio-disabled:9000
R2_ACCESS_KEY_ID=disabled
R2_SECRET_ACCESS_KEY=disabled

EMAIL_ENABLED=false
SENDGRID_FROM_EMAIL=noreply@atomicradius.local
SENDGRID_FROM_NAME=Atomic Radius
SENDGRID_API_KEY=
SENDGRID_WEBHOOK_PUBLIC_KEY=

SMS_ENABLED=false
CAPTCHA_ENABLED=false
CAPTCHA_PRIMARY_PROVIDER=none
HCAPTCHA_SITE_KEY=
HCAPTCHA_PUBLIC_SITE_KEY=
HCAPTCHA_SECRET_KEY=
TURNSTILE_SITE_KEY=
TURNSTILE_PUBLIC_SITE_KEY=
TURNSTILE_SECRET_KEY=

SEARCH_ENABLED=false
MEILISEARCH_URL=
MEILISEARCH_API_KEY=
METRICS_MODE=noop
VOICE_ENABLED=false
LIVEKIT_AUTO_CREATE_DUMMY_DATA=false
CLAMAV_ENABLED=false
CLAMAV_FAIL_OPEN=true
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
STRIPE_ENABLED=false
CLOUDFLARE_PURGE_ENABLED=false

PASSKEYS_ENABLED=false
PASSKEY_RP_NAME=Atomic Radius
PASSKEY_RP_ID=atomicradius.app
PASSKEY_ALLOWED_ORIGINS=https://atomicradius.app
SOCIAL_AUTH_ENABLED=false
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
APPLE_OAUTH_CLIENT_ID=
APPLE_OAUTH_CLIENT_SECRET=
FLUXER_COOKIE_DOMAIN=
FLUXER_COOKIE_SECURE=true

SELF_HOSTED=true
RELAX_REGISTRATION_RATE_LIMITS=true
DISABLE_RATE_LIMITS=true
ATTACHMENT_DECAY_ENABLED=false

ADMIN_OAUTH2_AUTO_CREATE=false
ADMIN_OAUTH2_REDIRECT_URI=https://atomicradius.app/admin/oauth2_callback
RELEASE_CHANNEL=stable
GIT_SHA=lite
BUILD_TIMESTAMP=

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=support@atomicradius.local
TENOR_API_KEY=
YOUTUBE_API_KEY=
ALERT_WEBHOOK_URL=
AUTO_JOIN_INVITE_CODE=
FLUXER_VISIONARIES_GUILD_ID=
FLUXER_OPERATORS_GUILD_ID=

SUDO_MODE_SECRET=change-me
SECRET_KEY_BASE=change-me
GATEWAY_RPC_SECRET=change-me
GATEWAY_ADMIN_SECRET=change-me
ERLANG_COOKIE=atomic_radius_lite_cookie
MEDIA_PROXY_SECRET_KEY=change-me
