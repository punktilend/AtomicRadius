# Copy these variable names into your shell environment before running object migration scripts.
# Do not commit real values.

B2_ENDPOINT_URL=https://s3.us-west-004.backblazeb2.com
B2_REGION=us-west-004
B2_KEY_ID=replace-with-backblaze-application-key-id
B2_APPLICATION_KEY=replace-with-backblaze-application-key

B2_STATIC_BUCKET=replace-with-current-static-bucket
B2_UPLOADS_BUCKET=replace-with-current-uploads-bucket
B2_REPORTS_BUCKET=replace-with-current-reports-bucket
B2_HARVESTS_BUCKET=replace-with-current-harvests-bucket
B2_DOWNLOADS_BUCKET=replace-with-current-downloads-bucket
